NODE_PORT=3000
NODE_ENV=development
JWT_TOKEN_KEY=your_jwt_secret_here
MONGODB_URI=mongodb://127.0.0.1:27017/caretracker_backend
# Fallback only — live links use the browser Origin / X-Frontend-URL from the request
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Email via Mailchimp (default). Set MAIL_MAILER=smtp only for legacy SMTP fallback.
MAIL_MAILER=mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=us9
MAILCHIMP_FROM_NAME=CareTracker
MAILCHIMP_FROM_EMAIL=info@caretracker.com
MAIL_FROM_ADDRESS=info@caretracker.com
