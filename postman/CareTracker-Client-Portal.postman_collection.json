                  "    pm.collectionVariables.set('carePlanId', String(first.id || first._id));",
                  "    console.log('Saved carePlanId', pm.collectionVariables.get('carePlanId'));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
