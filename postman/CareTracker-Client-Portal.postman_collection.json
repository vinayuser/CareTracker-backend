                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/care-plans",
              "host": ["{{baseUrl}}"],
              "path": ["client", "care-plans"]
            },
            "description": "Saves first `carePlanId` automatically."
          },
          "response": []
        },
        {
          "name": "Get Care Plan By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/care-plans/{{carePlanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["client", "care-plans", "{{carePlanId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Sign Care Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signature\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\",\n  \"name\": \"Jane Client\",\n  \"date\": \"2026-09-23\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/client/care-plans/{{carePlanId}}/sign",
              "host": ["{{baseUrl}}"],
              "path": ["client", "care-plans", "{{carePlanId}}", "sign"]
            },
            "description": "`signature` must be a `data:image/...` ink signature. Optional `name` and `date` (YYYY-MM-DD)."
          },
          "response": []
        }
      ]
    },
